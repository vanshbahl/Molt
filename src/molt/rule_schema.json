{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://molt.invalid/schemas/rule-bundle/v2.json",
  "title": "MoltRuleBundle",
  "description": "Canonical Molt rule bundle schema, version molt.rule.v2. Structural (JSON Schema) layer only; the semantic checks listed in DOCS/RULE_SPEC.md section 5 are enforced by src/molt/schema.py. Free-text fields (description, reason) are documentation and are never read by the engine.",
  "type": "object",
  "required": ["schema_version", "bundle_id", "bundle_version", "applies_to", "operations"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "molt.rule.v2" },
    "bundle_id": { "$ref": "#/$defs/slug" },
    "bundle_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "applies_to": {
      "type": "object",
      "required": ["library", "old_version_range", "new_version_range"],
      "additionalProperties": false,
      "properties": {
        "library": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "import_module": { "$ref": "#/$defs/identifier" },
        "old_version_range": { "$ref": "#/$defs/version_range" },
        "new_version_range": { "$ref": "#/$defs/version_range" }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/operation" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "authored_by": { "$ref": "#/$defs/text" },
        "generated_by": { "$ref": "#/$defs/text" },
        "timestamp": { "$ref": "#/$defs/text" },
        "source": { "$ref": "#/$defs/text" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
    "qualified_name": {
      "description": "Dotted import path of a module-level symbol, e.g. jwt.decode. At least two components.",
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)+$"
    },
    "module_path": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
    },
    "version_range": {
      "description": "PEP 440-style specifier set, e.g. '>=1.5,<2.0'. Documentation for the harness; the engine does not install dependencies.",
      "type": "string",
      "maxLength": 64,
      "pattern": "^(\\s*(==|!=|<=|>=|<|>|~=)\\s*[0-9][0-9A-Za-z.*+-]*\\s*)(,\\s*(==|!=|<=|>=|<|>|~=)\\s*[0-9][0-9A-Za-z.*+-]*\\s*)*$"
    },
    "text": { "type": "string", "maxLength": 500 },
    "op_id": { "$ref": "#/$defs/slug" },
    "typed_value": {
      "description": "A typed literal. Raw source-code strings are not accepted anywhere in the schema.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["type", "value"],
          "properties": { "type": { "const": "bool" }, "value": { "type": "boolean" } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "value"],
          "properties": { "type": { "const": "int" }, "value": { "type": "integer", "minimum": -1000000000, "maximum": 1000000000 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type", "value"],
          "properties": { "type": { "const": "str" }, "value": { "type": "string", "maxLength": 200 } }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["type"],
          "properties": { "type": { "const": "none" } }
        }
      ]
    },
    "argument_edit": {
      "description": "One edit to the keyword arguments of a single matched call. All edits in a replace_call apply atomically: every edit applies or the site abstains.",
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "keyword", "dict_keyword", "dict_key"],
          "properties": {
            "kind": { "const": "move_keyword_into_dict" },
            "keyword": { "$ref": "#/$defs/identifier" },
            "dict_keyword": { "$ref": "#/$defs/identifier" },
            "dict_key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$" },
            "when_dict_exists": { "enum": ["merge", "abstain"], "default": "merge" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "keyword", "new_keyword"],
          "properties": {
            "kind": { "const": "rename_keyword" },
            "keyword": { "$ref": "#/$defs/identifier" },
            "new_keyword": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "keyword"],
          "properties": {
            "kind": { "const": "remove_keyword" },
            "keyword": { "$ref": "#/$defs/identifier" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "keyword", "value"],
          "properties": {
            "kind": { "const": "add_keyword" },
            "keyword": { "$ref": "#/$defs/identifier" },
            "value": { "$ref": "#/$defs/typed_value" }
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "required": ["op"],
      "properties": {
        "op": { "enum": ["rename_symbol", "change_import", "rename_argument", "add_argument", "remove_argument", "replace_call", "abstain"] }
      },
      "allOf": [
        {
          "if": { "properties": { "op": { "const": "rename_symbol" } } },
          "then": {
            "additionalProperties": false,
            "required": ["op", "id", "qualified_old_name", "qualified_new_name"],
            "properties": {
              "op": true, "id": { "$ref": "#/$defs/op_id" },
              "qualified_old_name": { "$ref": "#/$defs/qualified_name" },
              "qualified_new_name": { "$ref": "#/$defs/qualified_name" },
              "description": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "change_import" } } },
          "then": {
            "additionalProperties": false,
            "required": ["op", "id", "old_module", "new_module", "name"],
            "properties": {
              "op": true, "id": { "$ref": "#/$defs/op_id" },
              "old_module": { "$ref": "#/$defs/module_path" },
              "new_module": { "$ref": "#/$defs/module_path" },
              "name": { "$ref": "#/$defs/identifier" },
              "new_name": { "$ref": "#/$defs/identifier" },
              "description": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "rename_argument" } } },
          "then": {
            "additionalProperties": false,
            "required": ["op", "id", "target_call", "old_arg_name", "new_arg_name"],
            "properties": {
              "op": true, "id": { "$ref": "#/$defs/op_id" },
              "target_call": { "$ref": "#/$defs/qualified_name" },
              "old_arg_name": { "$ref": "#/$defs/identifier" },
              "new_arg_name": { "$ref": "#/$defs/identifier" },
              "description": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "add_argument" } } },
          "then": {
            "additionalProperties": false,
            "required": ["op", "id", "target_call", "arg_name", "value"],
            "properties": {
              "op": true, "id": { "$ref": "#/$defs/op_id" },
              "target_call": { "$ref": "#/$defs/qualified_name" },
              "arg_name": { "$ref": "#/$defs/identifier" },
              "value": { "$ref": "#/$defs/typed_value" },
              "description": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "remove_argument" } } },
          "then": {
            "additionalProperties": false,
            "required": ["op", "id", "target_call", "arg_name"],
            "properties": {
              "op": true, "id": { "$ref": "#/$defs/op_id" },
              "target_call": { "$ref": "#/$defs/qualified_name" },
              "arg_name": { "$ref": "#/$defs/identifier" },
              "description": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "replace_call" } } },
          "then": {
            "additionalProperties": false,
            "required": ["op", "id", "target_call", "trigger_keyword", "argument_edits"],
            "properties": {
              "op": true, "id": { "$ref": "#/$defs/op_id" },
              "target_call": { "$ref": "#/$defs/qualified_name" },
              "trigger_keyword": {
                "description": "A call site is a candidate only when this keyword argument is present.",
                "$ref": "#/$defs/identifier"
              },
              "argument_edits": {
                "type": "array", "minItems": 1, "maxItems": 8,
                "items": { "$ref": "#/$defs/argument_edit" }
              },
              "description": { "$ref": "#/$defs/text" }
            }
          }
        },
        {
          "if": { "properties": { "op": { "const": "abstain" } } },
          "then": {
            "additionalProperties": false,
            "required": ["op", "id", "target_call", "reason"],
            "properties": {
              "op": true, "id": { "$ref": "#/$defs/op_id" },
              "target_call": { "$ref": "#/$defs/qualified_name" },
              "when_keyword_absent": {
                "description": "If set, only call sites lacking this keyword are flagged. If omitted, every call site is flagged.",
                "$ref": "#/$defs/identifier"
              },
              "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
            }
          }
        }
      ]
    }
  }
}
